# Nunca versionar o .env real. Nenhuma senha padrão é criada.
PORT=3000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=maximum_cnpj
WORKSPACE_ID=maximum
# Preencher somente para executar npm run seed. Remover depois.
ADMIN_NAME=Arthur Ferreira
ADMIN_EMAIL=programacao@maximumcontabil.com.br
ADMIN_PASSWORD=
# Consultas reais permanecem bloqueadas até configurar e verificar a fonte.
GOOGLE_CLOUD_PROJECT=
# Caminho local da credencial, OU identidade ADC do ambiente. Não usar no navegador.
GOOGLE_APPLICATION_CREDENTIALS=
# Em hospedagem sem arquivo, JSON da conta de serviço, apenas no segredo do servidor.
GOOGLE_CREDENTIALS_JSON=
BQ_SOURCE_TABLE=opencnpj-bigquery.public.receita
# Conferir localização real em npm run verify:source; não supor US.
BQ_LOCATION=
# Obrigatório. Bytes por consulta. Não equivale à franquia mensal.
BQ_MAXIMUM_BYTES_BILLED=
# Data fiscal/publicada verificada manualmente; não é a data técnica da tabela.
BQ_SOURCE_REFERENCE_DATE=
# Mapeamento explícito do indicador da fonte, a homologar; JSON de valores em texto.
BQ_FLAG_TRUE=["S","SIM","TRUE","1"]
BQ_FLAG_FALSE=["N","NAO","NÃO","FALSE","0"]
# Ativar somente depois da conferência do schema e dos valores em verify:source.
BQ_SOURCE_APPROVED=false
SOURCE_MAX_AGE_DAYS=60
# Somente produção: APP_ORIGIN=https://seu-dominio e NODE_ENV=production
