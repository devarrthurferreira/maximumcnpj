# Nunca versionar o .env real. Node.js + MongoDB; sem Google Cloud.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Na Vercel: APP_ORIGIN=https://maximum-cnpj.vercel.app (sem barra final).
# Domínios VERCEL_URL/VERCEL_BRANCH_URL/VERCEL_PROJECT_PRODUCTION_URL são lidos do ambiente confiável da plataforma.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=maximum_cnpj
WORKSPACE_ID=maximum
# Apenas para o primeiro provisionamento, via npm run seed ou primeiro login correspondente.
# Nenhuma conta existente é resetada. Remova ADMIN_PASSWORD depois.
ADMIN_NAME=Arthur Ferreira
ADMIN_EMAIL=programacao@maximumcontabil.com.br
ADMIN_PASSWORD=
# Produção: NODE_ENV=production. Consulta Minha Receita não exige chave.

# Opcional: provisionamento aditivo da equipe Maximum, sem resetar contas existentes.
# Alternativa: administrador autenticado usa POST /api/users/provision-maximum.
MAXIMUM_TEAM_INITIAL_PASSWORD=
MAXIMUM_ADMIN_INITIAL_PASSWORD=
