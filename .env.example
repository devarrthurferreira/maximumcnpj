# Nunca versionar o .env real. Node.js + MongoDB; sem Google Cloud.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Na Vercel: APP_ORIGIN=https://maximumcnpj.vercel.app (sem barra final).
# Domínios VERCEL_URL/VERCEL_BRANCH_URL/VERCEL_PROJECT_PRODUCTION_URL são lidos do ambiente confiável da plataforma.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=maximum_cnpj
# Opcional: sem pool, orçamento alocado do dashboard; com pool, orçamento de BSON + índices do cluster.
# Não é detecção automática do plano contratado no Atlas.
# MONGODB_STORAGE_LIMIT_BYTES=
# Pool opcional para os registros volumosos de consultas/compras/vendas.
# Cada URI adicional deve apontar para OUTRO cluster, com acesso readWrite ao seu banco.
# Sem URI_2/URI_3 o comportamento de banco único permanece igual.
# MONGODB_URI_2=mongodb+srv://USUARIO:SENHA@CLUSTER_2.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_2=maximum_cnpj
# MONGODB_URI_3=mongodb+srv://USUARIO:SENHA@CLUSTER_3.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_3=maximum_cnpj
# No pool, o orçamento padrão de cada destino é 536870912 bytes (512 MiB).
# MONGODB_STORAGE_LIMIT_BYTES_2=536870912
# MONGODB_STORAGE_LIMIT_BYTES_3=536870912
# Troca preventiva (50 a 90%; padrão 85), incluindo reserva para concluir cada importação.
# Usuários, sessões, cadastros, análises e diretório permanecem no MongoDB 1.
# MONGODB_ROLLOVER_PERCENT=85
WORKSPACE_ID=maximum
# Apenas para o primeiro provisionamento, via npm run seed ou primeiro login correspondente.
# Nenhuma conta existente é resetada. Remova ADMIN_PASSWORD depois.
ADMIN_NAME=Arthur Ferreira
ADMIN_EMAIL=programacao@maximumcontabil.com.br
ADMIN_PASSWORD=
# Produção: NODE_ENV=production. Consulta Minha Receita não exige chave.
# Opcionais: limites compartilhados entre abas/usuários no mesmo banco.
# Concorrência: 1 a 4. Intervalo mínimo entre consultas: 300 a 10000 ms.
LOOKUP_CONCURRENCY=4
LOOKUP_INTERVAL_MS=300

# Opcional: provisionamento aditivo da equipe Maximum, sem resetar contas existentes.
# Alternativa: administrador autenticado usa POST /api/users/provision-maximum.
MAXIMUM_TEAM_INITIAL_PASSWORD=
MAXIMUM_ADMIN_INITIAL_PASSWORD=

# Documentos fiscais / Extrato do Simples
# Preferido na Vercel: conecte um PRIVATE Blob Store ao projeto e use OIDC (sem segredo manual).
# Para desenvolvimento local ou store legado com token estático, informe:
BLOB_READ_WRITE_TOKEN=
# Não exponha esta variável no navegador e nunca prefixe com NEXT_PUBLIC_/VITE_.
