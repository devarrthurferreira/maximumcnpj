{
  "name": "maximum-cnpj",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "description": "Consultas CNPJ, histórico por empresa e relatórios Python com Node.js e MongoDB",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "npm run build && node --experimental-strip-types --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc && node scripts/assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/security.test.ts tests/imported.test.ts tests/http.test.ts tests/deployment.test.mjs tests/lookup.test.ts tests/lookup-performance.test.ts tests/lookup-http.test.ts tests/team.test.ts tests/purchase.test.ts tests/purchase-parser.test.mjs tests/purchase-model.test.mjs tests/simulator-engine.test.mjs tests/report-competence.test.ts tests/simulator-projection.test.mjs tests/simulation-extrato.test.ts tests/simulator-calendar.test.mjs tests/blob-documents.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration.test.ts tests/bootstrap.test.ts tests/team-integration.test.ts",
    "seed": "node --experimental-strip-types --env-file-if-exists=.env scripts/seed.ts",
    "test:e2e": "playwright test",
    "check:release": "node scripts/check-release.mjs",
    "benchmark:lookups": "node --experimental-strip-types scripts/benchmark-lookups.mjs",
    "test:lookup-integration": "node --experimental-strip-types --test tests/lookup-integration.test.ts tests/lookup-performance-integration.test.ts",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:reports": "python -m unittest discover -s tests -p '*_test.py' -v",
    "smoke": "node scripts/smoke-deployment.mjs",
    "provision:team": "node --experimental-strip-types --env-file-if-exists=.env scripts/provision-team.ts",
    "test:purchases-integration": "node --experimental-strip-types --test tests/purchase-integration.test.ts tests/difal-integration.test.ts",
    "test:generations-integration": "node --experimental-strip-types --test tests/generation-integration.test.ts tests/report-competence-integration.test.ts",
    "test:simulations-integration": "node --experimental-strip-types --test tests/simulation-integration.test.ts",
    "test:competences": "node --experimental-strip-types --test tests/report-competence.test.ts tests/report-competence-integration.test.ts",
    "test:projection": "node --experimental-strip-types --test tests/simulator-projection.test.mjs tests/simulator-projection-integration.test.ts"
  },
  "dependencies": {
    "mongodb": "6.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@vercel/blob": "2.8.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "@playwright/test": "1.55.1"
  }
}
